uniform mat4 LightViewProjection;
uniform mat4 ModelMatrix;

varying vec3 worldPosition;

void main(void) {
    vec4 worldPos = ModelMatrix * gl_Vertex;
    worldPosition = worldPos.xyz;
    gl_Position = LightViewProjection * worldPos;
}
