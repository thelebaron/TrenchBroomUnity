// Keep in sync with tb::render::MaxPreviewLights and shadow atlas constants
const float MAX_PREVIEW_LIGHTS_F = 256.0;
const float PREVIEW_SHADOW_TILE_SIZE = 256.0;
const float PREVIEW_SHADOW_ATLAS_COLS = 12.0;
const float PREVIEW_SHADOW_ATLAS_ROWS = 8.0;
const float PREVIEW_DIR_SHADOW_MAP_SIZE = 2048.0;

uniform float PreviewAmbient;
uniform int PreviewLightCount;
uniform sampler2D PreviewLightData;
uniform bool PreviewShadows;
uniform sampler2D PreviewShadowAtlas;
uniform bool PreviewDirShadowEnabled;
uniform mat4 PreviewDirLightViewProj;
uniform sampler2D PreviewDirShadowMap;

float tapShadowAtlas(vec2 tileOrigin, vec2 uv, vec2 invAtlasTiles, float tileMin, float tileMax, float refDepth) {
    vec2 atlasUV = (tileOrigin + clamp(uv, vec2(tileMin), vec2(tileMax))) * invAtlasTiles;
    float storedDepth = texture2D(PreviewShadowAtlas, atlasUV).r;
    return (refDepth <= storedDepth) ? 1.0 : 0.0;
}

float samplePreviewShadow(
    int slot,
    bool soft,
    vec3 worldCoords,
    vec3 normal,
    vec3 lightPos,
    float range) {
    // Normal-offset bias shifts the lookup slightly off the surface along its normal
    // to prevent self-shadow acne at grazing angles without peter-panning.
    float normalBias = max(1.5, range * 0.005);
    vec3 samplePos = worldCoords + normal * normalBias;

    vec3 d = samplePos - lightPos;
    float sampleDist = length(d);
    if (sampleDist >= range) {
        return 1.0;
    }

    vec3 ad = abs(d);
    int face = 0;
    float ma = 1.0;
    float sc = 0.0;
    float tc = 0.0;

    if (ad.x >= ad.y && ad.x >= ad.z) {
        ma = ad.x;
        if (d.x >= 0.0) {
            face = 0;
            sc = -d.y;
            tc = d.z;
        } else {
            face = 1;
            sc = d.y;
            tc = d.z;
        }
    } else if (ad.y >= ad.x && ad.y >= ad.z) {
        ma = ad.y;
        if (d.y >= 0.0) {
            face = 2;
            sc = d.x;
            tc = d.z;
        } else {
            face = 3;
            sc = -d.x;
            tc = d.z;
        }
    } else {
        ma = ad.z;
        if (d.z >= 0.0) {
            face = 4;
            sc = d.x;
            tc = -d.y;
        } else {
            face = 5;
            sc = d.x;
            tc = d.y;
        }
    }

    vec2 uv = vec2(sc, tc) / max(ma, 0.0001) * 0.5 + 0.5;
    float tileMin = 0.5 / PREVIEW_SHADOW_TILE_SIZE;
    float tileMax = 1.0 - tileMin;

    int row = slot / 2;
    int colPair = slot - row * 2;
    vec2 tileOrigin = vec2(float(colPair * 6 + face), float(row));
    vec2 invAtlasTiles = vec2(1.0 / PREVIEW_SHADOW_ATLAS_COLS, 1.0 / PREVIEW_SHADOW_ATLAS_ROWS);

    float refDepth = sampleDist / range - 0.0025;
    float center = tapShadowAtlas(tileOrigin, uv, invAtlasTiles, tileMin, tileMax, refDepth);
    if (!soft) {
        return center;
    }

    // 5-tap PCF without nested loops to keep GLSL IR compact for desktop drivers.
    float step = 1.25 / PREVIEW_SHADOW_TILE_SIZE;
    float lit = center;
    lit += tapShadowAtlas(tileOrigin, uv + vec2(-step, -step), invAtlasTiles, tileMin, tileMax, refDepth);
    lit += tapShadowAtlas(tileOrigin, uv + vec2(step, -step), invAtlasTiles, tileMin, tileMax, refDepth);
    lit += tapShadowAtlas(tileOrigin, uv + vec2(-step, step), invAtlasTiles, tileMin, tileMax, refDepth);
    lit += tapShadowAtlas(tileOrigin, uv + vec2(step, step), invAtlasTiles, tileMin, tileMax, refDepth);
    return lit * 0.2;
}

float tapDirShadow(vec2 uv, float refDepth) {
    float storedDepth = texture2D(PreviewDirShadowMap, clamp(uv, vec2(0.0), vec2(1.0))).r;
    return (refDepth <= storedDepth) ? 1.0 : 0.0;
}

float samplePreviewDirectionalShadow(bool soft, vec3 worldCoords, vec3 normal) {
    vec3 samplePos = worldCoords + normal * 2.0;
    vec4 clip = PreviewDirLightViewProj * vec4(samplePos, 1.0);
    vec3 ndc = clip.xyz / max(clip.w, 0.0001);
    vec2 uv = ndc.xy * 0.5 + 0.5;
    float currentDepth = ndc.z * 0.5 + 0.5;

    if (
        uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0 || currentDepth <= 0.0
        || currentDepth >= 1.0) {
        return 1.0;
    }

    float refDepth = currentDepth - 0.0015;
    float center = tapDirShadow(uv, refDepth);
    if (!soft) {
        return center;
    }

    float step = 1.25 / PREVIEW_DIR_SHADOW_MAP_SIZE;
    float lit = center;
    lit += tapDirShadow(uv + vec2(-step, -step), refDepth);
    lit += tapDirShadow(uv + vec2(step, -step), refDepth);
    lit += tapDirShadow(uv + vec2(-step, step), refDepth);
    lit += tapDirShadow(uv + vec2(step, step), refDepth);
    return lit * 0.2;
}

// Mirrors cyberjunk's retro shading model:
// - Linear distance attenuation: clamp(1.0 - dist / range, 0.0, 1.0)
// - Spot cone attenuation: saturate(dot(-spotForward, lightDir) * x + y)^2
// - Clamped Valve Half-Lambert: (clamp(dot(N, L), 0, 1) * 0.5 + 0.5)^2
// - Hue-preserving accumulation cap: lit / max(maxChannel(lit), 1.0)
vec3 applyPreviewLighting(vec3 albedo, vec3 worldCoords, vec3 normal) {
    vec3 totalLight = vec3(PreviewAmbient);

    // Use the dynamic uniform upper bound directly so drivers do not attempt to
    // statically unroll 256 iterations of shadowed lighting at shader link time.
    for (int i = 0; i < PreviewLightCount; ++i) {
        float u = (float(i) + 0.5) / MAX_PREVIEW_LIGHTS_F;
        vec4 posRange = texture2D(PreviewLightData, vec2(u, 0.125));
        vec4 colorIntensity = texture2D(PreviewLightData, vec2(u, 0.375));
        vec4 dirType = texture2D(PreviewLightData, vec2(u, 0.625));

        float lightType = dirType.w;
        float shadowMeta = colorIntensity.w;

        if (lightType > 1.5) {
            vec3 lightDir = normalize(-dirType.xyz);
            float shadowAtten = 1.0;
            if (PreviewShadows && PreviewDirShadowEnabled && abs(shadowMeta) > 0.5) {
                bool soft = shadowMeta < 0.0;
                shadowAtten = samplePreviewDirectionalShadow(soft, worldCoords, normal);
                if (shadowAtten <= 0.0) {
                    continue;
                }
            }

            float ndotl = clamp(dot(normal, lightDir), 0.0, 1.0);
            ndotl = ndotl * 0.5 + 0.5;
            ndotl = ndotl * ndotl;

            totalLight += colorIntensity.rgb * (shadowAtten * ndotl);
            continue;
        }

        float range = posRange.w;
        if (range <= 0.0) {
            continue;
        }

        vec3 toLight = posRange.xyz - worldCoords;
        float dist = length(toLight);
        if (dist >= range) {
            continue;
        }

        vec3 lightDir = (dist > 0.0001) ? (toLight / dist) : normal;
        float atten = clamp(1.0 - dist / range, 0.0, 1.0);

        if (lightType > 0.5) {
            vec4 spotParams = texture2D(PreviewLightData, vec2(u, 0.875));
            float alignment = dot(-dirType.xyz, lightDir);
            float cone = clamp(alignment * spotParams.x + spotParams.y, 0.0, 1.0);
            atten *= cone * cone;
            if (atten <= 0.0) {
                continue;
            }
        }

        float shadowAtten = 1.0;
        if (PreviewShadows && abs(shadowMeta) > 0.5) {
            bool soft = shadowMeta < 0.0;
            int slot = int(abs(shadowMeta) - 0.5);
            shadowAtten = samplePreviewShadow(
                slot, soft, worldCoords, normal, posRange.xyz, range);
            if (shadowAtten <= 0.0) {
                continue;
            }
        }

        float ndotl = clamp(dot(normal, lightDir), 0.0, 1.0);
        ndotl = ndotl * 0.5 + 0.5;
        ndotl = ndotl * ndotl;

        totalLight += colorIntensity.rgb * (atten * shadowAtten * ndotl);
    }

    vec3 lit = albedo * totalLight;
    float maxChannel = max(max(lit.r, lit.g), lit.b);
    return lit / max(maxChannel, 1.0);
}
